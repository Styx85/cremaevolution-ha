# Copy to capture.env (chmod 600) and fill in. capture.env is not committed.
# MAC address of the coffee machine's Wi-Fi module (router's device list).
MODULE_MAC=aa:bb:cc:dd:ee:ff
# FRITZ!Box address and the capture interface (fritz_capture.py --list).
FRITZ_URL=http://fritz.box
FRITZ_IFACE=1-lan
# SSH login of the Home Assistant "Advanced SSH & Web Terminal" add-on.
HA_SSH=hassio@homeassistant.local
