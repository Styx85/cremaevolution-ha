{
  "config": {
    "step": {
      "user": {
        "title": "Sign in to De'Longhi Coffee Link",
        "description": "Sign in once to find your machine and fetch its local key. Afterwards the machine is controlled over your local network; only a refresh token is stored, never the password. Tick \"Manual setup\" if you already know the machine's IP address and LAN key.",
        "data": {
          "email": "Email",
          "password": "Password",
          "manual_setup": "Manual setup (IP address and LAN key)"
        }
      },
      "select": {
        "title": "Choose a machine",
        "description": "Your account has more than one coffee machine.",
        "data": {
          "dsn": "Machine"
        }
      },
      "manual": {
        "title": "Manual setup",
        "description": "The machine must be reachable on your network and must have been connected to the De'Longhi cloud at least once since its last restart.",
        "data": {
          "device_ip": "IP address of the machine",
          "lan_key": "LAN key",
          "profile": "Machine family",
          "name": "Name (optional)"
        }
      },
      "reauth_confirm": {
        "title": "Sign in again",
        "description": "Sign in to Coffee Link to refresh the access for {name}. This also fetches the local key for entries that were migrated from the cloud connection.",
        "data": {
          "email": "Email",
          "password": "Password"
        }
      },
      "reconfigure": {
        "title": "Change the IP address",
        "data": {
          "device_ip": "IP address of the machine"
        }
      }
    },
    "error": {
      "invalid_auth": "Email or password is wrong.",
      "cannot_connect": "Could not reach the service or the machine.",
      "missing_credentials": "Enter email and password, or tick Manual setup.",
      "no_machines": "No coffee machine was found on this account.",
      "module_not_ready": "The machine's Wi-Fi module currently refuses local connections. It needs to reach the De'Longhi cloud once after a restart; check its internet access and try again in a few minutes.",
      "machine_not_on_account": "This machine is not on the account you signed in with.",
      "wrong_machine": "A different machine answers at this address."
    },
    "abort": {
      "already_configured": "This machine is already configured.",
      "no_lan": "The cloud has no local key for this machine (local connection disabled). Enable the local connection in the Coffee Link app or use manual setup.",
